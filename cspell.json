// cSpell Settings
{
    // Version of the setting file (Always 0.2)
    "version": "0.2",
    // Current active spelling language
    "language": "en",
    // Settings
    "allowCompoundWords": true,
    // Ignored phrases
    "ignoreRegExpList": [
        "\\[[\\d;]+m", // Escape sequences (followed by a word)
        "\\\\f[A-Z]", // Man page sequences
        "tmp",
    ],
    // List of words to be always considered correct
    "words": [
        "swiftycode", "clitheme",
        "feof", "reof",
        "themedef", "themedefs", "clithemeinfo", "ctdef", "infofile", 
        "substrules", "manpages",
        "exactcmdmatch", "smartcmdmatch", "endmatchhere",
        "leadtabindents", "leadspaces", 
        "strictcmdmatch", "normalcmdmatch", "exactcmdmatch", "smartcmdmatch",
        "subststdoutonly", "subststderronly", "substallstreams",
        "foregroundonly", "noforegroundonly",
        "substvar", "substesc", "substchar", "linebounds",
        "nosubstvar", "nosubstesc", "nosubstchar", "nolinebounds",
        "tcgetattr", "tcsetattr", "getpid", "setsid", "setitimer", "tcgetpgrp", "tcsetpgrp",
        "TIOCGWINSZ", "TIOCSWINSZ", "TCSADRAIN", "SIGWINCH", "SIGALRM", "ITIMER", "SIGTSTP", "SIGSTOP", "SIGCONT", "SIGUSR1", "SIGUSR2",
        "nosubst",
        "dpkg", "pybuild", "pyproject", "pycache", "venv",
    ]
}